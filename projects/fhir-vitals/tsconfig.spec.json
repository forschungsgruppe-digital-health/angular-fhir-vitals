/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/spec",
    "types": ["jasmine"],
    // Specs test the sources of all entry points, so no build of dist is needed first.
    "paths": {
      "fhir-vitals/core": ["./core/src/public-api.ts"],
      "fhir-vitals/fhir": ["./fhir/src/public-api.ts"],
      "fhir-vitals/angular/data": ["./angular/data/src/public-api.ts"],
      "fhir-vitals/angular/ui": ["./angular/ui/src/public-api.ts"],
      "fhir-vitals/angular/dashboard": ["./angular/dashboard/src/public-api.ts"]
    }
  },
  "include": [
    "core/**/*.spec.ts",
    "fhir/**/*.spec.ts",
    "angular/**/*.spec.ts"
  ]
}
