/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "types": [],
    // The editor finds the other entry points in their sources, before the first build.
    // ng-packagr puts its own mapping to the built entry points in front of these.
    "paths": {
      "fhir-vitals/core": ["./core/src/public-api.ts"],
      "fhir-vitals/fhir": ["./fhir/src/public-api.ts"],
      "fhir-vitals/angular/data": ["./angular/data/src/public-api.ts"],
      "fhir-vitals/angular/ui/cards": ["./angular/ui/cards/src/public-api.ts"],
      "fhir-vitals/angular/ui/dashboard": [
        "./angular/ui/dashboard/src/public-api.ts"
      ]
    }
  },
  "include": ["src/**/*.ts", "core/**/*.ts", "fhir/**/*.ts", "angular/**/*.ts"],
  "exclude": ["**/*.spec.ts"]
}
